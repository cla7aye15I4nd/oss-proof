  0xca, 0x2c, 0x50, 0x48, 0xad, 0x28, 0x29, 0x4a, 0x54, 0x48, 0xcb, 0x4c,
  0xcd, 0x49, 0x51, 0xc8, 0xa0, 0x86, 0x30, 0x00, 0x75, 0x8e, 0x9c, 0xa6,
  0x5c, 0x00, 0x00, 0x00]

def calls : M String := do
  let s ← allocZStream
  stZStream s ZStream.zeroed
  let ver ← allocBytesRO ("1.4".toUTF8.data.push 0)
  let inp ← allocBytesRO gz
  let out ← allocBytes (Array.replicate 200 0)
  let extra ← allocBytes (Array.replicate 10 0)
  let head ← allocGzHeader
  stGzHeader head { GzHeader.zeroed with extra := extra, extra_max := 10 }
  let rc ← inflateInit2_ s 31 ver 112
  let hd ← inflateGetHeader s head
  wrZ s fun z => { z with next_out := out, avail_out := 200, next_in := inp, avail_in := 42 }
  let r1 ← inflate s Z_NO_FLUSH
  wrZ s fun z => { z with avail_in := (gz.size - 42).toUInt32 }
  let r2 ← inflate s Z_NO_FLUSH
  let z ← ldZStream s
  let g ← ldGzHeader head
  let mut ok := r2 == Z_STREAM_END && z.total_out == 92 && g.done == 1 && g.extra_len == 100
  for i in [0:10] do
    ok := ok && (← index8 extra i) == gz[12 + i]!
  let _ ← inflateEnd s
  return s!"init={rc.toInt} header={hd.toInt} inflate={r1.toInt},{r2.toInt} out={z.total_out.toNat} extra_len={g.extra_len.toNat} output {if ok then "ok" else "WRONG"}"

def main : IO Unit :=
  IO.println <| match C.run calls fullHeap with
    | .ok (s, _) => s
    | .error f => showFault f
