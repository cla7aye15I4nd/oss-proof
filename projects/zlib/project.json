{
  "version": 1,
  "id": "zlib",
  "title": "zlib",
  "package": "ZlibF",
  "upstream": {
    "submodule": "zlib",
    "repository": "https://github.com/madler/zlib",
    "version": "1.4",
    "target": "default x86_64 Linux LP64 static build, default allocator",
    "patches_dir": "patches"
  },
  "build": {
    "targets": [
      "ZlibF"
    ],
    "results_module": "ZlibF.Results",
    "compiler_helpers": "tests/audit/compiler-helpers.txt"
  },
  "checks": {
    "spec_layers": {
      "spec_dir": "ZlibF/Spec",
      "math_dir": "ZlibF/Math",
      "proof_dir": "ZlibF/Proof",
      "math_proof_imports_script": "scripts/check-spec-layers.py"
    },
    "strlit": "scripts/check-strlit.py",
    "coverage": {
      "manifest": "tests/audit/public-api.json",
      "script": "scripts/verification.py"
    },
    "results_self_test": "tests/results-check/run.sh",
    "self_tests": [
      "tests/verification/test_spec_layers.py",
      "tests/verification/test_strlit_check.py",
      "tests/verification/test_options_check.py",
      "tests/verification/test_coverage.py"
    ]
  },
  "difftest": {
    "dir": "tests",
    "list": "tests/list.txt",
    "upstream_env": "ZLIB_SRC",
    "command": "SAN=1 ZLIB_SRC=\"$UPSTREAM_DIR\" bash tests/run.sh",
    "watch_paths": [
      "ZlibF/Zlib/",
      "ZlibF/Runtime/",
      "tests/lean/",
      "tests/c/",
      "tests/gen/",
      "tests/regression/",
      "patches/",
      "zlib"
    ]
  },
  "site": {
    "route": "zlib",
    "brand": "zlib × Lean",
    "builder": "docs/web/build.py",
    "checker": "docs/web/check.py",
    "js_tests": "docs/web/tests/*.test.mjs",
    "findings_count": 8,
    "patches_count": 7,
    "summary": {
      "en": "Every documented public function of the default x86_64 Linux build of zlib 1.4 (with seven patches) is proved safe over every call sequence, together with the round trip of the default zlib stream.",
      "zh": "默认 x86_64 Linux 构建下 zlib 1.4（含七个补丁）中每个有文档公开函数对任意输入与调用序列均已证明安全，并证明默认 zlib 流的往返性质。"
    }
  }
}
