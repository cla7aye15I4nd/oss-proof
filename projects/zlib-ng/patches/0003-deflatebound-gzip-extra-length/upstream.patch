From 415d41f295b880886240ac77c2136fe8c403359d Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 10:59:38 -0800
Subject: [PATCH] Mask the gzip extra length in deflateBound()

deflate() writes only the low 16 bits of gzhead->extra_len into the gzip
header (put_short() of the uint16_t cast, and the EXTRA_STATE copy loop
masks with 0xffff), but deflateBound() added the full 32-bit value.

2 + extra_len is unsigned int arithmetic on every platform. For extra_len
0x10000..0xfffffffd the bound is too large; for 0xfffffffe and 0xffffffff
the sum wraps to 0 or 1, so the bound is 65536 bytes too small and a
single deflate(Z_FINISH) into deflateBound() bytes returns Z_OK instead of
Z_STREAM_END. There is no buffer overflow.

Add 2 + (extra_len & 0xffff), the bytes deflate() writes, and a test
comparing the bound with that of the 16-bit length.
---
 deflate.c                  |  2 +-
 test/test_deflate_bound.cc | 45 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/deflate.c b/deflate.c
index 2cfd7d2..7c4fc7f 100644
--- a/deflate.c
+++ b/deflate.c
@@ -734,7 +734,7 @@ z_size_t Z_EXPORT PREFIX(deflateBound_z)(PREFIX3(stream) *strm, z_size_t sourceL
         if (s->gzhead != NULL) {            /* user-supplied gzip header */
             unsigned char *str;
             if (s->gzhead->extra != NULL) {
-                wraplen += 2 + s->gzhead->extra_len;
+                wraplen += 2 + (s->gzhead->extra_len & 0xffff);
             }
             str = s->gzhead->name;
             if (str != NULL) {
diff --git a/test/test_deflate_bound.cc b/test/test_deflate_bound.cc
index c86d4e0..cf60f97 100644
--- a/test/test_deflate_bound.cc
+++ b/test/test_deflate_bound.cc
@@ -97,3 +97,48 @@ TEST_P(deflate_bound_variant, estimate) {
 }
 
 INSTANTIATE_TEST_SUITE_P(deflate_bound, deflate_bound_variant, testing::ValuesIn(tests));
+
+#ifndef TEST_STOCK_ZLIB
+/* deflate() writes only the low 16 bits of gzhead->extra_len, so deflateBound() counts only those */
+TEST(deflate_bound, gzip_extra_len) {
+    static const uint32_t extra_lens[] = {0xffff, 0x10000, 0xfffffffe, 0xffffffff};
+    static uint8_t extra[0xffff];
+    PREFIX3(stream) strm;
+    PREFIX(gz_header) header;
+    z_size_t bound, expected;
+    uint8_t *out;
+
+    memset(extra, 'e', sizeof(extra));
+    for (size_t i = 0; i < sizeof(extra_lens) / sizeof(extra_lens[0]); i++) {
+        memset(&header, 0, sizeof(header));
+        header.os = 3;
+        header.extra = extra;
+
+        /* the bound of the same header with the 16-bit length deflate() writes */
+        header.extra_len = extra_lens[i] & 0xffff;
+        memset(&strm, 0, sizeof(strm));
+        ASSERT_EQ(PREFIX(deflateInit2)(&strm, Z_DEFAULT_COMPRESSION, Z_DEFLATED, MAX_WBITS + 16, MAX_MEM_LEVEL,
+            Z_DEFAULT_STRATEGY), Z_OK);
+        ASSERT_EQ(PREFIX(deflateSetHeader)(&strm, &header), Z_OK);
+        expected = PREFIX(deflateBound)(&strm, 0);
+        EXPECT_EQ(PREFIX(deflateEnd)(&strm), Z_OK);
+
+        header.extra_len = extra_lens[i];
+        memset(&strm, 0, sizeof(strm));
+        ASSERT_EQ(PREFIX(deflateInit2)(&strm, Z_DEFAULT_COMPRESSION, Z_DEFLATED, MAX_WBITS + 16, MAX_MEM_LEVEL,
+            Z_DEFAULT_STRATEGY), Z_OK);
+        ASSERT_EQ(PREFIX(deflateSetHeader)(&strm, &header), Z_OK);
+        bound = PREFIX(deflateBound)(&strm, 0);
+        EXPECT_EQ(bound, expected) << "extra_len: " << extra_lens[i];
+
+        /* one deflate(Z_FINISH) into deflateBound() bytes completes the stream */
+        out = (uint8_t *)malloc(bound);
+        ASSERT_TRUE(out != NULL);
+        strm.next_out = out;
+        strm.avail_out = (uint32_t)bound;
+        EXPECT_EQ(PREFIX(deflate)(&strm, Z_FINISH), Z_STREAM_END) << "extra_len: " << extra_lens[i];
+        EXPECT_EQ(PREFIX(deflateEnd)(&strm), Z_OK);
+        free(out);
+    }
+}
+#endif
