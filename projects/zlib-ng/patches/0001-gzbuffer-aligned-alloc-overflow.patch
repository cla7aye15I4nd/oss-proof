diff --git a/gzlib.c b/gzlib.c
index 016a0a6..f2f7ea9 100644
--- a/gzlib.c
+++ b/gzlib.c
@@ -69,8 +69,8 @@ static void gz_reset(gz_state *state) {
 
 /* Allocate in/out buffers for gzFile */
 int Z_INTERNAL gz_buffer_alloc(gz_state *state) {
-    int want = state->want;
-    int in_size = want, out_size = want;
+    uint32_t want = state->want;
+    uint32_t in_size = want, out_size = want;
 
     if (state->mode == GZ_WRITE) {
         in_size = want * 2; // double input buffer for compression (ref: gzprintf)
@@ -331,9 +331,9 @@ z_int32_t Z_EXPORT PREFIX(gzbuffer)(gzFile file, z_uint32_t size) {
     if (state->size != 0)
         return -1;
 
-    /* check and set requested size */
-    if ((size << 1) < size)
-        return -1;              /* need to be able to double it */
+    /* check and set requested size (in_size + out_size is 3 * want) */
+    if (size > (unsigned)(INT_MAX / 3))
+        return -1;
     if (size < 8)
         size = 8;               /* needed to behave well with flushing */
     state->want = size;
