From 5a0aeafa15d84146ac865fc14bec904706de734b Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Thu, 19 Nov 2026 14:31:48 -0800
Subject: [PATCH] Do not leave next_in pointing at the caller's buffer in
 gz_write()

The direct path of gz_write() points strm.next_in at the caller's buffer and
left it there, with avail_in nonzero after a failed write. After gzclearerr()
later writes computed a pointer difference across objects and copied past the
input buffer, and gzclose()/gzflush() compressed the caller's (possibly freed)
buffer. Reset avail_in and next_in on failure and next_in after success.
---
 gzwrite.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/gzwrite.c b/gzwrite.c
index 14593da..4cfaa96 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -208,10 +208,15 @@ static size_t gz_write(gz_state *state, void const *buf, size_t len) {
                 n = (unsigned)len;
             state->strm.avail_in = n;
             state->x.pos += n;
-            if (gz_comp(state, Z_NO_FLUSH) == -1)
+            if (gz_comp(state, Z_NO_FLUSH) == -1) {
+                /* do not keep a pointer into the caller's buffer */
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
                 return 0;
+            }
             len -= n;
         } while (len);
+        state->strm.next_in = state->in;
     }
 
     /* input was all buffered or compressed */
