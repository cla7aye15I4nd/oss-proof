From b039a511f09e1de16d5fb5905b6dd418282f28c7 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Thu, 19 Nov 2026 14:31:48 -0800
Subject: [PATCH] Do not leave next_in pointing at the caller's buffer in
 gz_write()

The direct path of gz_write() (a write of at least the buffer size) points
strm.next_in at the caller's buffer. When gz_comp() failed, gz_write()
returned 0 and left next_in there with avail_in nonzero after gzwrite() had
returned:

- gzclose(), gzflush() and gzsetparams() then wrote or compressed avail_in
  bytes of the caller's buffer, which the caller may have freed;
- after gzclearerr(), a small gzwrite(), gzputc() or gzprintf() computed
  (next_in + avail_in) - state->in across two objects and copied past the
  end of the input buffer.

On failure, set avail_in to 0 and next_in to state->in before returning, and
point next_in back at state->in after the direct path succeeds. These are
the lines madler/zlib added in gz_write() with df84af25 (failure path) and
6be4bcda (after the loop).

Add tests that fail a direct gzwrite() on a full non-blocking pipe, then
close, or clear the error and write one byte.
---
 gzwrite.c                      |  7 ++-
 test/test_gzfile_api_errors.cc | 80 ++++++++++++++++++++++++++++++++++
 2 files changed, 86 insertions(+), 1 deletion(-)

diff --git a/gzwrite.c b/gzwrite.c
index 14593da..4cfaa96 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -208,10 +208,15 @@ static size_t gz_write(gz_state *state, void const *buf, size_t len) {
                 n = (unsigned)len;
             state->strm.avail_in = n;
             state->x.pos += n;
-            if (gz_comp(state, Z_NO_FLUSH) == -1)
+            if (gz_comp(state, Z_NO_FLUSH) == -1) {
+                /* do not keep a pointer into the caller's buffer */
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
                 return 0;
+            }
             len -= n;
         } while (len);
+        state->strm.next_in = state->in;
     }
 
     /* input was all buffered or compressed */
diff --git a/test/test_gzfile_api_errors.cc b/test/test_gzfile_api_errors.cc
index 2ee59b6..c7d16b8 100644
--- a/test/test_gzfile_api_errors.cc
+++ b/test/test_gzfile_api_errors.cc
@@ -1003,3 +1003,83 @@ TEST(gzfile_api_errors, setparams_direct_write) {
     EXPECT_EQ(PREFIX(gzclose)(file), Z_OK);
     remove("gzapi_err_setparams.gz");
 }
+
+#ifndef _WIN32
+/* Make both ends of a pipe non-blocking and fill it, so that the next write()
+ * to fds[1] fails with EAGAIN without writing anything. */
+static bool fill_pipe(int fds[2]) {
+    char fill[4096];
+    if (pipe(fds) != 0)
+        return false;
+    for (int i = 0; i < 2; i++)
+        if (fcntl(fds[i], F_SETFL, fcntl(fds[i], F_GETFL) | O_NONBLOCK) != 0)
+            return false;
+    memset(fill, 'f', sizeof(fill));
+    while (write(fds[1], fill, sizeof(fill)) > 0) {}
+    while (write(fds[1], fill, 1) > 0) {}
+    return true;
+}
+
+/* Read everything available from the non-blocking read end of a pipe. */
+static void drain_pipe(int fd) {
+    char buf[4096];
+    while (read(fd, buf, sizeof(buf)) > 0) {}
+}
+
+/* gzclose() after a failed direct gzwrite():
+ * - a write of at least the buffer size goes straight from the caller's
+ *   buffer; when write() fails, gzwrite() returns 0 with Z_ERRNO;
+ * - gzwrite() has returned, so the caller may free its buffer; gzclose() must
+ *   not write any of it to the file (here the pipe has room again by then). */
+TEST(gzfile_api_errors, write_failed_direct_close) {
+    int fds[2];
+    ASSERT_TRUE(fill_pipe(fds));
+    gzFile file = PREFIX(gzdopen)(fds[1], "wT");
+    ASSERT_NE(file, (gzFile)NULL);
+    EXPECT_EQ(PREFIX(gzbuffer)(file, 8), Z_OK);
+
+    char *buf = (char *)malloc(100);
+    ASSERT_NE(buf, (char *)NULL);
+    memset(buf, 'a', 100);
+    EXPECT_EQ(PREFIX(gzwrite)(file, buf, 100), 0);
+    int errnum = Z_OK;
+    PREFIX(gzerror)(file, &errnum);
+    EXPECT_EQ(errnum, Z_ERRNO);
+    free(buf);
+
+    drain_pipe(fds[0]);
+    EXPECT_EQ(PREFIX(gzclose)(file), Z_OK);
+    char rest[16];
+    EXPECT_EQ(read(fds[0], rest, sizeof(rest)), 0);
+    close(fds[0]);
+}
+
+/* A small gzwrite() after a failed direct gzwrite() and gzclearerr():
+ * - the small write is buffered in the descriptor's own input buffer, never
+ *   at a position derived from the caller's earlier buffer;
+ * - only the small write reaches the file. */
+TEST(gzfile_api_errors, write_failed_direct_clearerr) {
+    int fds[2];
+    ASSERT_TRUE(fill_pipe(fds));
+    gzFile file = PREFIX(gzdopen)(fds[1], "wT");
+    ASSERT_NE(file, (gzFile)NULL);
+    EXPECT_EQ(PREFIX(gzbuffer)(file, 8), Z_OK);
+
+    char *buf = (char *)malloc(100);
+    ASSERT_NE(buf, (char *)NULL);
+    memset(buf, 'a', 100);
+    EXPECT_EQ(PREFIX(gzwrite)(file, buf, 100), 0);
+    free(buf);
+
+    PREFIX(gzclearerr)(file);
+    EXPECT_EQ(PREFIX(gzwrite)(file, "x", 1), 1);
+    drain_pipe(fds[0]);
+    EXPECT_EQ(PREFIX(gzclose)(file), Z_OK);
+    char rest[16];
+    ssize_t n = read(fds[0], rest, sizeof(rest));
+    EXPECT_EQ(n, 1);
+    if (n == 1)
+        EXPECT_EQ(rest[0], 'x');
+    close(fds[0]);
+}
+#endif
