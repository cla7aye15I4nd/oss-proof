From 64f857b75077720b8826b4c6cf0fd99bdf21d7f3 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Thu, 19 Nov 2026 11:59:19 -0800
Subject: [PATCH] Do not form window - match_offset in longest_match

In the slow matchers mbase_start was moved back by match_offset, which points
before the start of the deflate allocation when match_offset exceeds the
alignment padding before the window. Keep mbase_start at the window and
subtract match_offset from cur_match instead; every address read is unchanged.
---
 match_tpl.h | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/match_tpl.h b/match_tpl.h
index a05461f..bc9a9f9 100644
--- a/match_tpl.h
+++ b/match_tpl.h
@@ -130,8 +130,6 @@ Z_INTERNAL uint32_t LONGEST_MATCH(deflate_state *const s, uint32_t cur_match) {
         limit = limit_base+match_offset;
         if (UNLIKELY(cur_match <= limit))
             return best_len;
-        mbase_start -= match_offset;
-        mbase_end -= match_offset;
     }
 #endif
     Assert(strstart <= s->fill_end, "need lookahead");
@@ -148,7 +146,7 @@ Z_INTERNAL uint32_t LONGEST_MATCH(deflate_state *const s, uint32_t cur_match) {
          */
         uint32_t len;
         if (best_len < sizeof(uint64_t)) {
-            uint64_t cand_start = zng_memread_8(mbase_start + cur_match);
+            uint64_t cand_start = zng_memread_8(mbase_start + (cur_match - match_offset));
             if (scan_start != cand_start) {
                 /* Peel the first candidate out of the loop. A full 8-byte match falls straight
                  * through to compare256, and single-candidate chains (barely-compressible data)
@@ -163,7 +161,7 @@ Z_INTERNAL uint32_t LONGEST_MATCH(deflate_state *const s, uint32_t cur_match) {
                 }
                 if (--chain_length == 0 || (cur_match = prev[cur_match & wmask]) <= limit)
                     return best_len;
-                cand_start = zng_memread_8(mbase_start + cur_match);
+                cand_start = zng_memread_8(mbase_start + (cur_match - match_offset));
                 if (scan_start != cand_start) {
                     /* Walk the remaining candidates with the chain advance kept inline. */
                     for (;;) {
@@ -174,7 +172,7 @@ Z_INTERNAL uint32_t LONGEST_MATCH(deflate_state *const s, uint32_t cur_match) {
                         }
                         if (--chain_length == 0 || (cur_match = prev[cur_match & wmask]) <= limit)
                             return best_len;
-                        cand_start = zng_memread_8(mbase_start + cur_match);
+                        cand_start = zng_memread_8(mbase_start + (cur_match - match_offset));
                         if (scan_start == cand_start)
                             break;
                     }
@@ -187,14 +185,14 @@ Z_INTERNAL uint32_t LONGEST_MATCH(deflate_state *const s, uint32_t cur_match) {
             for (;;) {
                 /* First check the end of the candidate at best_len+1 due to the higher
                  * likelihood of a mismatch. */
-                if (zng_memcmp_8(mbase_end+cur_match, &scan_end) == 0 &&
-                    zng_memcmp_8(mbase_start+cur_match, &scan_start) == 0)
+                if (zng_memcmp_8(mbase_end+(cur_match-match_offset), &scan_end) == 0 &&
+                    zng_memcmp_8(mbase_start+(cur_match-match_offset), &scan_start) == 0)
                     break;
                 GOTO_NEXT_CHAIN;
             }
         }
 
-        len = COMPARE256(scan+2, mbase_start+cur_match+2) + 2;
+        len = COMPARE256(scan+2, mbase_start+(cur_match-match_offset)+2) + 2;
         Assert(scan+len <= window+(unsigned)(s->window_size-1), "wild scan");
 
         if (len > best_len)
@@ -284,7 +282,6 @@ short_match_accept:
 
                 /* Update offset-dependent variables */
                 limit = limit_base+match_offset;
-                mbase_start = window-match_offset;
                 mbase_end = (mbase_start+offset);
                 continue;
             }
