From 158a0ff8408c11eafc074f9fd3a54edc9836f667 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 01:53:11 -0800
Subject: [PATCH] Refuse gzseek64() seeks whose offset arithmetic would
 overflow

gzseek64() adds the pending skip, subtracts the current position and forms the
lseek() offset in z_off64_t without a bound, which overflows (signed) for
positions near 2^63 or after gzungetc() at position 0. Return -1 where that
arithmetic would overflow and otherwise run the existing statements, and skip
the buffer update when there is nothing to skip (x.next may be unset).
---
 gzguts.h |  1 +
 gzlib.c  | 31 ++++++++++++++++++++++---------
 2 files changed, 23 insertions(+), 9 deletions(-)

diff --git a/gzguts.h b/gzguts.h
index 93bd943..f1956ff 100644
--- a/gzguts.h
+++ b/gzguts.h
@@ -157,5 +157,6 @@ unsigned Z_INTERNAL gz_intmax(void);
    value -- needed when comparing unsigned to z_off64_t, which is signed
    (possible z_off64_t types off_t, off64_t, and long are all signed) */
 #define GT_OFF(x) (sizeof(int) == sizeof(z_off64_t) && (x) > INT_MAX)
+#define GZ_OFF_MAX ((z_off64_t)((~(uint64_t)0) >> (65 - sizeof(z_off64_t) * 8)))
 
 #endif /* GZGUTS_H_ */
diff --git a/gzlib.c b/gzlib.c
index b827351..608dabb 100644
--- a/gzlib.c
+++ b/gzlib.c
@@ -405,16 +405,27 @@ z_off64_t Z_EXPORT PREFIX4(gzseek)(gzFile file, z_off64_t offset, int whence) {
     if (whence != SEEK_SET && whence != SEEK_CUR)
         return -1;
 
-    /* normalize offset to a SEEK_CUR specification */
-    if (whence == SEEK_SET)
+    /* normalize offset to a SEEK_CUR specification, refusing a seek whose
+       offset or target position does not fit in z_off64_t */
+    if (whence == SEEK_SET) {
+        if (state->x.pos < 0 ? offset > GZ_OFF_MAX + state->x.pos :
+                               offset < state->x.pos - GZ_OFF_MAX - 1)
+            return -1;
         offset -= state->x.pos;
-    else {
+    } else {
+        if (!state->past && offset > GZ_OFF_MAX - state->skip)
+            return -1;
         offset += state->past ? 0 : state->skip;
+        if (state->x.pos > 0 ? offset > GZ_OFF_MAX - state->x.pos :
+                               offset < -GZ_OFF_MAX - 1 - state->x.pos)
+            return -1;
         state->skip = 0;
     }
 
-    /* if within raw area while reading, just go there */
-    if (state->mode == GZ_READ && state->how == COPY && state->x.pos + offset >= 0) {
+    /* if within raw area while reading, just go there (if the lseek()
+       offset fits) */
+    if (state->mode == GZ_READ && state->how == COPY && state->x.pos + offset >= 0 &&
+            !GT_OFF(state->x.have) && offset >= (z_off64_t)state->x.have - GZ_OFF_MAX - 1) {
         ret = LSEEK(state->fd, offset - (z_off64_t)state->x.have, SEEK_CUR);
         if (ret == -1)
             return -1;
@@ -442,10 +453,12 @@ z_off64_t Z_EXPORT PREFIX4(gzseek)(gzFile file, z_off64_t offset, int whence) {
     /* if reading, skip what's in output buffer (one less gzgetc() check) */
     if (state->mode == GZ_READ) {
         n = GT_OFF(state->x.have) || (z_off64_t)state->x.have > offset ? (unsigned)offset : state->x.have;
-        state->x.have -= n;
-        state->x.next += n;
-        state->x.pos += n;
-        offset -= n;
+        if (n) {
+            state->x.have -= n;
+            state->x.next += n;
+            state->x.pos += n;
+            offset -= n;
+        }
     }
 
     /* request skip (if not zero) */
