From cf16b025876ac1ee3c6a9f580b983e1f11c50292 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 00:31:17 -0800
Subject: [PATCH] Take each batch of zeros off skip before writing it in
 gz_zero()

gz_zero() added a batch to x.pos and took it off skip only after a successful
write, so a failed write left it counted in both: gztell() overflowed after a
seek near 2^63, and a retry wrote the zeros twice. Take the batch off skip when
it is added to x.pos; a failed batch stays in the input buffer and is written
first on the next call.
---
 gzwrite.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gzwrite.c b/gzwrite.c
index ef1ef37..9e9a08e 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -155,9 +155,9 @@ static int gz_zero(gz_state *state) {
         strm->avail_in = n;
         strm->next_in = state->in;
         state->x.pos += n;
+        state->skip -= n;
         if (gz_comp(state, Z_NO_FLUSH) == -1)
             return -1;
-        state->skip -= n;
     } while (state->skip);
     return 0;
 }
