From 67afeac14bdddbdd578ecc6e11527fca8ba2d25a Mon Sep 17 00:00:00 2001
From: Mark Adler <git@madler.net>
Date: Wed, 16 Sep 2026 23:26:14 +0000
Subject: [PATCH 1/3] Fix buffer overflow bug in non-blocking gzwrite.

This addresses CVE-2026-85091.

Adapted from madler/zlib@df84af25 for zlib-ng's gz_write().
---
 gzwrite.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/gzwrite.c b/gzwrite.c
index 14593da3..4e4da6ec 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -201,16 +201,21 @@ static size_t gz_write(gz_state *state, void const *buf, size_t len) {
             return 0;
 
         /* directly compress user buffer to file */
-        state->strm.next_in = (z_const unsigned char *) buf;
+        state->strm.next_in = (z_const unsigned char *)buf;
         do {
             unsigned n = (unsigned)-1;
             if (n > len)
                 n = (unsigned)len;
             state->strm.avail_in = n;
+            int ret = gz_comp(state, Z_NO_FLUSH);
+            n -= state->strm.avail_in;
             state->x.pos += n;
-            if (gz_comp(state, Z_NO_FLUSH) == -1)
-                return 0;
             len -= n;
+            if (ret == -1) {
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
+                return 0;
+            }
         } while (len);
     }
 

From 3dab21177c148fbaaf96f7c1c3c209c82c303ba3 Mon Sep 17 00:00:00 2001
From: Mark Adler <git@madler.net>
Date: Mon, 26 Oct 2026 16:31:04 +0000
Subject: [PATCH 2/3] Avoid undefined pointer comparisons in gz_vacate().

They had no effect whatsoever, except to annoy sanitizers.

Adapted from madler/zlib@6be4bcda.
---
 gzwrite.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/gzwrite.c b/gzwrite.c
index 4e4da6ec..56cde58e 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -26,6 +26,8 @@ static int gz_write_init(gz_state *state) {
         return -1;
     }
 
+    strm->next_in = NULL;
+
     /* only need deflate state if compressing */
     if (!state->direct) {
         /* allocate deflate memory, set up for gzip compression */
@@ -39,8 +41,6 @@ static int gz_write_init(gz_state *state) {
             }
             return -1;
         }
-        strm->next_in = NULL;
-
         /* initialize write buffer */
         strm->avail_out = state->size;
         strm->next_out = state->out;
@@ -217,6 +217,7 @@ static size_t gz_write(gz_state *state, void const *buf, size_t len) {
                 return 0;
             }
         } while (len);
+        state->strm.next_in = state->in;
     }
 
     /* input was all buffered or compressed */

From b37442f53d20c832d9c45211829a684329acdb91 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 00:30:00 -0800
Subject: [PATCH 3/3] Add regression tests for failed direct gzwrite()

Cover freeing the caller buffer before gzclose() and issuing a small buffered
gzwrite() after gzclearerr() following a failed direct gzwrite().
---
 test/test_gzfile_api_errors.cc | 44 ++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/test/test_gzfile_api_errors.cc b/test/test_gzfile_api_errors.cc
index 2ee59b66..ff3b90d1 100644
--- a/test/test_gzfile_api_errors.cc
+++ b/test/test_gzfile_api_errors.cc
@@ -1003,3 +1003,47 @@ TEST(gzfile_api_errors, setparams_direct_write) {
     EXPECT_EQ(PREFIX(gzclose)(file), Z_OK);
     remove("gzapi_err_setparams.gz");
 }
+
+#ifndef _WIN32
+/* A failed large direct gzwrite must not leave strm.next_in pointing at the
+ * freed caller buffer for a subsequent gzclose() or gzclearerr() + gzwrite(). */
+TEST(gzfile_api_errors, write_failed_direct_close) {
+    int fd = open("/dev/null", O_RDONLY);
+    ASSERT_GE(fd, 0);
+    gzFile file = PREFIX(gzdopen)(fd, "wbT");
+    if (file == NULL)
+        close(fd);
+    ASSERT_NE(file, (gzFile)NULL);
+
+    EXPECT_EQ(PREFIX(gzbuffer)(file, 8), Z_OK);
+    char *buf = (char *)malloc(100);
+    ASSERT_NE(buf, nullptr);
+    memset(buf, 'a', 100);
+    EXPECT_EQ(PREFIX(gzwrite)(file, buf, 100), 0);
+    free(buf);
+    EXPECT_EQ(PREFIX(gzclose)(file), Z_ERRNO);
+}
+
+TEST(gzfile_api_errors, write_failed_direct_clearerr) {
+    int fd = open("/dev/null", O_RDONLY);
+    ASSERT_GE(fd, 0);
+    gzFile file = PREFIX(gzdopen)(fd, "wbT");
+    if (file == NULL)
+        close(fd);
+    ASSERT_NE(file, (gzFile)NULL);
+
+    EXPECT_EQ(PREFIX(gzbuffer)(file, 8), Z_OK);
+    char *buf = (char *)malloc(100);
+    ASSERT_NE(buf, nullptr);
+    memset(buf, 'a', 100);
+    EXPECT_EQ(PREFIX(gzwrite)(file, buf, 100), 0);
+    free(buf);
+    int err = Z_OK;
+    PREFIX(gzerror)(file, &err);
+    EXPECT_EQ(err, Z_ERRNO);
+
+    PREFIX(gzclearerr)(file);
+    EXPECT_EQ(PREFIX(gzwrite)(file, "x", 1), 1);
+    EXPECT_EQ(PREFIX(gzclose)(file), Z_ERRNO);
+}
+#endif
