From 6a27e1457128194ee665a9591b474311e3ace63f Mon Sep 17 00:00:00 2001
From: "ronald.eytchison@trailofbits.com" <ronald.eytchison@trailofbits.com>
Date: Fri, 5 Jun 2026 19:10:16 +0000
Subject: [PATCH 1/2] Clear gz skip when forced seek reaches EOF.

Adapted from madler/zlib@f40786e3 (TOB-ZLIB-006): when gz_skip() reaches the
end of the input, clear state->skip and mark state->past so gztell() reports
the actual end-of-file offset rather than the unreached seek target.
---
 gzread.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/gzread.c b/gzread.c
index 0c6937f..3253908 100644
--- a/gzread.c
+++ b/gzread.c
@@ -272,6 +272,8 @@ static int gz_skip(gz_state *state) {
             state->skip -= n;
         } else if (state->eof && state->strm.avail_in == 0) {
             /* output buffer empty -- return if we're at the end of the input */
+            state->skip = 0;
+            state->past = 1;
             break;
         } else {
             /* need more data to skip -- load up output buffer */

From 11a324d40817c98b6461ebfe7471c362b63a38ab Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 00:30:00 -0800
Subject: [PATCH 2/2] Do not fetch past EOF or a pending skip in gzgets()

Unlike gz_read(), gzgets() did not check `state->eof && state->strm.avail_in == 0`
before calling gz_fetch(). If a pending skip stopped at EOF and the underlying
file later grew without gzclearerr(), gzgets() fetched and returned bytes from
before the seek target and could advance x.pos past GZ_OFF_MAX if skip remained
set. Match gz_read()'s EOF check and test both gzungetc(-1) EOF reporting and
appended-file behavior.
---
 gzread.c            |  5 +++++
 test/test_gzseek.cc | 43 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/gzread.c b/gzread.c
index 3253908..80bda47 100644
--- a/gzread.c
+++ b/gzread.c
@@ -539,6 +539,11 @@ char * Z_EXPORT PREFIX(gzgets)(gzFile file, char *buf, z_int32_t len) {
     left = (unsigned)len - 1;
     if (left) {
         do {
+            /* return at end of input or pending seek instead of re-fetching */
+            if (state->x.have == 0 && (state->skip || (state->eof && state->strm.avail_in == 0))) {
+                state->past = 1;            /* read past end */
+                break;                      /* return what we have */
+            }
             /* assure that something is in the output buffer */
             if (state->x.have == 0 && gz_fetch(state) == -1)
                 return NULL;                /* error */
diff --git a/test/test_gzseek.cc b/test/test_gzseek.cc
index c14a073..2a8874f 100644
--- a/test/test_gzseek.cc
+++ b/test/test_gzseek.cc
@@ -62,3 +62,46 @@ TEST(gzip, seek) {
     PREFIX(gzclose)(file);
 #endif
 }
+
+TEST(gzip, gets_pending_skip_after_eof) {
+    const char *path = "seek_gets_eof_grow.txt";
+    FILE *fp = fopen(path, "wb");
+    ASSERT_NE(fp, nullptr);
+    ASSERT_EQ(fwrite("abc", 1, 3, fp), 3U);
+    ASSERT_EQ(fclose(fp), 0);
+
+    gzFile file = PREFIX(gzopen)(path, "rb");
+    ASSERT_NE(file, (gzFile)NULL);
+#if !defined(ZLIB_COMPAT) || defined(Z_LARGE64)
+    const z_off64_t off_max =
+        (z_off64_t)((((uint64_t)1 << (sizeof(z_off64_t) * 8 - 2)) - 1) * 2 + 1);
+#  ifdef ZLIB_COMPAT
+    EXPECT_EQ(PREFIX4(gzseek)(file, off_max, SEEK_SET), off_max);
+#  else
+    EXPECT_EQ(PREFIX(gzseek)(file, off_max, SEEK_SET), off_max);
+#  endif
+    /* Force execution of the pending seek to EOF. */
+    EXPECT_EQ(PREFIX(gzungetc)(-1, file), -1);
+#  ifdef ZLIB_COMPAT
+    EXPECT_EQ(PREFIX4(gztell)(file), 3);
+#  else
+    EXPECT_EQ(PREFIX(gztell)(file), 3);
+#  endif
+
+    /* Appending after EOF without gzclearerr() must not make gzgets() read pre-seek data. */
+    fp = fopen(path, "ab");
+    ASSERT_NE(fp, nullptr);
+    ASSERT_EQ(fwrite("de\n", 1, 3, fp), 3U);
+    ASSERT_EQ(fclose(fp), 0);
+
+    char buf[16];
+    EXPECT_EQ(PREFIX(gzgets)(file, buf, sizeof(buf)), nullptr);
+#  ifdef ZLIB_COMPAT
+    EXPECT_EQ(PREFIX4(gztell)(file), 3);
+#  else
+    EXPECT_EQ(PREFIX(gztell)(file), 3);
+#  endif
+#endif
+    EXPECT_EQ(PREFIX(gzclose)(file), Z_OK);
+    remove(path);
+}
