From 00996039e54ac50493277f795d6d1497f239aa0f Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 00:30:00 -0800
Subject: [PATCH] Avoid comparing inflate output with a separate sliding window

chunkcopy_safe() / CHUNKCOPY_SAFE() compare and subtract their source and
destination pointers to handle self-overlapping copies. When inflate() copies a
match from its internal sliding window into the caller's output buffer, those
pointers refer to distinct allocations (ISO C17 6.5.6p9, 6.5.8p5).

Because inflate() guarantees window copies fit the remaining output space and
cannot overlap the caller buffer, copy with memcpy() directly:
- In inflate.c MATCH state, use memcpy().
- In the non-safe inflate_fast() instantiation (called only by inflate()), use
  memcpy() unconditionally with no branch.
- In the USE_SAFE_MODE instantiation (shared with inflateBack(), where beg ==
  window and copies inside the window may overlap), retain CHUNKCOPY_SAFE() /
  chunkcopy_safe() when window == beg and use memcpy() otherwise.

Add tests for chunked inflate() window copies and overlapping inflateBack()
windows.
---
 inffast_tpl.h                     | 48 +++++++++++++----
 inflate.c                         |  4 +-
 test/test_inflate_back.cc         | 90 +++++++++++++++++++++++++++++++
 test/test_inflate_far_distance.cc | 28 ++++++++++
 4 files changed, 159 insertions(+), 11 deletions(-)

diff --git a/inffast_tpl.h b/inffast_tpl.h
index 25298c6..f1c8896 100644
--- a/inffast_tpl.h
+++ b/inffast_tpl.h
@@ -255,32 +255,60 @@ void Z_INTERNAL INFLATE_FAST(PREFIX3(stream) *strm, uint32_t start) {
                         from += wsize - op;
                         if (UNLIKELY(op < len)) {       /* some from end of window */
                             len -= op;
-                            out = CHUNKCOPY_SAFE(out, from, op, safe);
+#ifdef USE_SAFE_MODE
+                            if (window == beg) {
+                                out = CHUNKCOPY_SAFE(out, from, op, safe);
+                            } else {
+                                memcpy(out, from, op);
+                                out += op;
+                            }
+#else
+                            memcpy(out, from, op);
+                            out += op;
+#endif
                             from = window;              /* more from start of window */
                             op = wnext;
-                            /* This (rare) case can create a situation where
-                               the first chunkcopy below must be checked.
-                             */
                         }
                     }
                     if (UNLIKELY(op < len)) {           /* still need some from output */
                         len -= op;
 #ifndef USE_SAFE_MODE
-                        out = CHUNKCOPY_SAFE(out, from, op, safe);
+                        memcpy(out, from, op);
+                        out += op;
                         out = CHUNKUNROLL(out, &dist, &len);
                         out = CHUNKCOPY_SAFE(out, out - dist, len, safe);
 #elif defined(HAVE_MASKED_READWRITE)
-                        out = CHUNKCOPY_SAFE(out, from, op, safe);
+                        if (window == beg) {
+                            out = CHUNKCOPY_SAFE(out, from, op, safe);
+                        } else {
+                            memcpy(out, from, op);
+                            out += op;
+                        }
                         out = CHUNKCOPY_SAFE(out, out - dist, len, safe);
 #else
-                        out = chunkcopy_safe(out, from, op, safe);
+                        if (window == beg) {
+                            out = chunkcopy_safe(out, from, op, safe);
+                        } else {
+                            memcpy(out, from, op);
+                            out += op;
+                        }
                         out = chunkcopy_safe(out, out - dist, len, safe);
 #endif
                     } else {
-#if !defined(USE_SAFE_MODE) || defined(HAVE_MASKED_READWRITE)
-                        out = CHUNKCOPY_SAFE(out, from, len, safe);
+#ifndef USE_SAFE_MODE
+                        memcpy(out, from, len);
+                        out += len;
 #else
-                        out = chunkcopy_safe(out, from, len, safe);
+                        if (window == beg) {
+#  ifdef HAVE_MASKED_READWRITE
+                            out = CHUNKCOPY_SAFE(out, from, len, safe);
+#  else
+                            out = chunkcopy_safe(out, from, len, safe);
+#  endif
+                        } else {
+                            memcpy(out, from, len);
+                            out += len;
+                        }
 #endif
                     }
                 } else {
diff --git a/inflate.c b/inflate.c
index 9c88b53..c057249 100644
--- a/inflate.c
+++ b/inflate.c
@@ -1097,7 +1097,9 @@ int32_t Z_EXPORT PREFIX(inflate)(PREFIX3(stream) *strm, int32_t flush) {
