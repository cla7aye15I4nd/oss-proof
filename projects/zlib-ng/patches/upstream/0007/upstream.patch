diff --git a/test/test_inflate_back.cc b/test/test_inflate_back.cc
index 4c8535a..790f31d 100644
--- a/test/test_inflate_back.cc
+++ b/test/test_inflate_back.cc
@@ -14,6 +14,7 @@
 #include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
+#include <vector>
 
 #include <gtest/gtest.h>
 
@@ -320,3 +321,92 @@ TEST(inflate_back_distance, match_inside_output) {
     EXPECT_EQ(decoded[2], 0xa5);
     EXPECT_EQ(decoded[3], 0xa5);
