From 686e7db29633e544665b372b3c70488d306bc556 Mon Sep 17 00:00:00 2001
From: Zheng Yu <dataisland@outlook.com>
Date: Fri, 20 Nov 2026 00:30:43 -0800
Subject: [PATCH] Refuse gz writes that would move the position past GZ_OFF_MAX

The writers added each length to the signed 64-bit x.pos without a bound.
gz_write(), gzputc() and gzvprintf() now refuse such a write with
Z_DATA_ERROR before touching the caller's data.
---
 gzwrite.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/gzwrite.c b/gzwrite.c
index 4cfaa96..ef1ef37 100644
--- a/gzwrite.c
+++ b/gzwrite.c
@@ -8,6 +8,11 @@
 #include <stdarg.h>
 #include "gzguts.h"
 
+/* the largest value of x.pos (also defined in gzguts.h with the gzseek64 fix) */
+#ifndef GZ_OFF_MAX
+#define GZ_OFF_MAX ((z_off64_t)((~(uint64_t)0) >> (65 - sizeof(z_off64_t) * 8)))
+#endif
+
 /* Local functions */
 static int gz_write_init(gz_state *);
 static int gz_comp(gz_state *, int);
@@ -174,6 +179,13 @@ static size_t gz_write(gz_state *state, void const *buf, size_t len) {
     if (state->skip && gz_zero(state) == -1)
         return 0;
 
+    /* the position after the write must fit in x.pos (compared in 64 bits:
+       size_t may be narrower than z_off64_t) */
+    if ((uint64_t)len > (uint64_t)(GZ_OFF_MAX - state->x.pos)) {
+        PREFIX(gz_error)(state, Z_DATA_ERROR, "write position does not fit in z_off64_t");
+        return 0;
+    }
+
     /* for small len, copy to input buffer, otherwise compress directly */
     if (len < state->size) {
         /* copy to input buffer, compress when full */
@@ -303,7 +315,7 @@ z_int32_t Z_EXPORT PREFIX(gzputc)(gzFile file, z_int32_t c) {
         if (strm->avail_in == 0)
             strm->next_in = state->in;
         have = (unsigned)((strm->next_in + strm->avail_in) - state->in);
-        if (have < state->size) {
+        if (have < state->size && state->x.pos != GZ_OFF_MAX) {
             state->in[have] = (unsigned char)c;
             strm->avail_in++;
             state->x.pos++;
@@ -381,6 +393,12 @@ z_int32_t Z_EXPORTVA PREFIX(gzvprintf)(gzFile file, const char *format, va_list
     if (len == 0 || (unsigned)len >= state->size || next[state->size - 1] != 0)
         return 0;
 
+    /* the position after the write must fit in x.pos */
+    if (len > GZ_OFF_MAX - state->x.pos) {
+        PREFIX(gz_error)(state, Z_DATA_ERROR, "write position does not fit in z_off64_t");
+        return state->err;
+    }
+
     /* update buffer and position, compress first half if past that */
     strm->avail_in += (unsigned)len;
     state->x.pos += len;
